PORT=3000
NODE_ENV=development
JWT_SECRET=huddle_super_secret_jwt_key_change_in_production_min_32_chars_123456
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
USE_HTTPS=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
# STUN/TURN configuration
# Public STUN is used by default. For production behind NAT/firewalls, set TURN credentials:
# TURN_URLS=turn:your-turn-server.com:3478
# TURN_USERNAME=huddle-user
# TURN_CREDENTIAL=huddle-turn-secret
